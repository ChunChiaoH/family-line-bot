# Copy to .env and fill in. .env is gitignored (and .gcloudignore'd) — never commit it.
# In production the three true secrets live in GCP Secret Manager; the rest are plain env vars.
# See .claude/commands/deploy.md and wiki/deployment.md.

# --- LINE Messaging API (LINE Developers console → your Messaging API channel) ---
LINE_CHANNEL_ID=            # channel ID (numeric); used by scripts/set_webhook.py
LINE_CHANNEL_SECRET=        # SECRET — webhook HMAC signature verification
LINE_CHANNEL_ACCESS_TOKEN=  # SECRET — long-lived channel access token (reply/push/content)

# --- Anthropic ---
ANTHROPIC_API_KEY=          # SECRET — console.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-6   # optional; web_search tool needs Sonnet 4.6+/Opus (not Haiku)

# --- Webhook & access control ---
WEBHOOK_PATH_TOKEN=         # random string; webhook served at /webhook/<token>. Obscurity, not a credential. Empty = /webhook
ALLOWED_CHAT_IDS=           # comma-separated LINE group/room chat IDs allowed to use the bot. EMPTY = allow all (dev only). How to obtain: wiki/operations.md

# --- GCP (production; leave USE_FIRESTORE unset for local in-memory mode) ---
USE_FIRESTORE=false         # true = persist chats/memory in Firestore
GCP_PROJECT=                # project ID; empty = auto-detect via ADC / `gcloud config get-value project`
MEDIA_BUCKET=               # e.g. <your-project-id>-media; empty = photos/video thumbs stay in-process only

# --- TDX (Taiwan transport open data — powers the search_thsr tool) ---
TDX_CLIENT_ID=              # tdx.transportdata.tw member API key
TDX_CLIENT_SECRET=          # SECRET — paired with TDX_CLIENT_ID

# --- Behaviour tuning (all optional; defaults shown) ---
# BOT_PERSONA=              # overrides the built-in persona in family_line_bot/config.py
# CONTEXT_WINDOW_HOURS=12   # how far back conversation context reaches
# MAX_HISTORY=50            # max messages pulled into context
# SESSION_WINDOW_MINUTES=10 # after a bot reply, how long soft (model-judged) triggering stays open
# AUTO_DESCRIBE_IMAGES=false # 1:1 chats only: describe images on arrival (costs tokens)
